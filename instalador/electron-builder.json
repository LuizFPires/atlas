{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "br.com.atlas.app",
  "productName": "Atlas",
  "copyright": "Atlas",
  "electronVersion": "45.4.1",
  "extraMetadata": {
    "main": "app/main.cjs"
  },
  "directories": {
    "output": "release",
    "buildResources": "instalador/recursos",
    "app": "."
  },
  "files": [
    "app/**/*",
    "dist-app/**/*",
    "package.json",
    "!app/**/*.teste.cjs",
    "!app/PENDENTE-ENTREGAR.md"
  ],
  "win": {
    "icon": "instalador/recursos/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Atlas-Instalador-${version}.${ext}",
    "azureSignOptions": {
      "publisherName": "${env.AZURE_PUBLISHER_NAME}",
      "endpoint": "${env.AZURE_TS_ENDPOINT}",
      "certificateProfileName": "${env.AZURE_TS_PROFILE}",
      "codeSigningAccountName": "${env.AZURE_TS_ACCOUNT}"
    }
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "runAfterFinish": false,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true,
    "shortcutName": "Atlas",
    "include": "instalador/atlas-install.nsh",
    "language": "1046"
  },
  "protocols": [
    {
      "name": "Atlas",
      "schemes": [
        "atlas"
      ]
    }
  ],
  "extraResources": [
    {
      "from": ".claude/canteiro",
      "to": "kit/canteiro"
    },
    {
      "from": ".claude/hooks",
      "to": "kit/hooks"
    },
    {
      "from": "instalador/instalar.ps1",
      "to": "instalador/instalar.ps1"
    },
    {
      "from": "instalador/executar.mjs",
      "to": "instalador/executar.mjs"
    },
    {
      "from": "instalador/passos.ts",
      "to": "instalador/passos.ts"
    },
    {
      "from": "instalador/caminhos.ts",
      "to": "instalador/caminhos.ts"
    }
  ],
  "mac": {
    "icon": "instalador/recursos/icon-mac.png",
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "universal"
        ]
      }
    ],
    "artifactName": "Atlas-${version}-mac.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "instalador/entitlements.mac.plist",
    "entitlementsInherit": "instalador/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "O Atlas usa o microfone para você falar em vez de digitar."
    },
    "notarize": true
  },
  "dmg": {
    "title": "Atlas",
    "contents": [
      {
        "x": 150,
        "y": 190
      },
      {
        "x": 450,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 600,
      "height": 400
    }
  }
}
