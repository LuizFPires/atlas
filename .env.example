# Variáveis do Atlas — só os NOMES. Valores reais ficam no cofre/ambiente (Supabase secrets, Vercel), nunca em arquivo no repositório.

# ── Site (build do Vite, públicas) ──
# Endereço das funções do servidor, sem barra no final.
VITE_API_URL=
# Id da conta de pagamento (contas_gateway.id) usada pela página de vendas.
VITE_CONTA_ID=
# Portal do cliente (/conta): endereço do Supabase e chave "anon" (pública por desenho; a proteção é o RLS e o servidor).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Servidor (Supabase Edge Functions, secretas) ──
# Origem https do site que pode chamar /pagamento/checkout e /cadastro (CORS). Ex.: https://seu-site.com.br
ATLAS_WEB_ORIGEM=
ATLAS_SEGREDO=
ATLAS_SERVICO_TOKEN=
ATLAS_SIGN_SK=
# Por conta de pagamento: STRIPE_<ref>_SK e STRIPE_<ref>_WHSEC, onde <ref> é contas_gateway.segredo_ref.
